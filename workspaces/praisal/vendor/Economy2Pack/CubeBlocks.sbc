		<Definition xsi:type="MyObjectBuilder_SafeZoneBlockDefinition">
			<Id>
				<TypeId>SafeZoneBlock</TypeId>
				<SubtypeId>SafeZoneBlockReskin</SubtypeId>
			</Id>
			<DisplayName>DisplayName_Block_SafeZoneReskin</DisplayName>
			<Icon>Textures\GUI\Icons\Cubes\SafeZoneReskin.dds</Icon>
			<Description>Description_SafeZone</Description>
			<CubeSize>Large</CubeSize>
			<BlockTopology>TriangleMesh</BlockTopology>
			<Size x="2" y="2" z="3" />
			<ModelOffset x="0" y="0" z="0" />
			<Model>Models\Cubes\Large\SafeZoneReskin.mwm</Model>
			<Components>
				<Component Subtype="SteelPlate" Count="750" />
				<Component Subtype="Construction" Count="180" />
				<Component Subtype="GravityGenerator" Count="10" />
				<Component Subtype="ZoneChip" Count="5" />
				<Component Subtype="MetalGrid" Count="80" />
				<Component Subtype="Computer" Count="120" />
				<Component Subtype="SteelPlate" Count="50" />
			</Components>
			<CriticalComponent Subtype="Computer" Index="0" />
			<MountPoints>
				<MountPoint Side="Bottom" StartX="0" StartY="0" EndX="2" EndY="3" />
				<MountPoint Side="Top" StartX="0.8" StartY="0" EndX="1.2" EndY="0.5" />
				<MountPoint Side="Top" StartX="0.8" StartY="2.5" EndX="1.2" EndY="3" />
				<MountPoint Side="Right" StartX="0" StartY="0" EndX="0.2" EndY="1" />
				<MountPoint Side="Right" StartX="2.8" StartY="0" EndX="3" EndY="1" />
				<MountPoint Side="Right" StartX="1" StartY="0" EndX="2" EndY="1" />
				<MountPoint Side="Left" StartX="0" StartY="0" EndX="0.2" EndY="1" />
				<MountPoint Side="Left" StartX="2.8" StartY="0" EndX="3" EndY="1" />
				<MountPoint Side="Back" StartX="0" StartY="0" EndX="2" EndY="1.3" />
                <MountPoint Side="Back" StartX="0.5" StartY="1.3" EndX="1.5" EndY="2" />
				<MountPoint Side="Front" StartX="0" StartY="0" EndX="2" EndY="1.3" />
                <MountPoint Side="Front" StartX="0.5" StartY="1.3" EndX="1.5" EndY="2" />
			</MountPoints>
			<BuildProgressModels>
				<Model BuildPercentUpperBound="0.33" File="Models\Cubes\large\SafeZoneReskin_Construction_1.mwm" />
				<Model BuildPercentUpperBound="0.66" File="Models\Cubes\large\SafeZoneReskin_Construction_2.mwm" />
				<Model BuildPercentUpperBound="1.00" File="Models\Cubes\large\SafeZoneReskin_Construction_3.mwm" />
			</BuildProgressModels>
			<BlockPairName>SafeZoneReskin</BlockPairName>
			<EdgeType>Light</EdgeType>
			<MirroringX>Y</MirroringX>
			<MirroringY>X</MirroringY>
			<BuildTimeSeconds>40</BuildTimeSeconds>
			<ResourceSinkGroup>SafeZoneBlock</ResourceSinkGroup>
			<DamageEffectName>Damage_Electrical_Damaged</DamageEffectName>
			<DamagedSound>ParticleElectrical</DamagedSound>

			<MaxSafeZoneRadius>500</MaxSafeZoneRadius>
			<MinSafeZoneRadius>10</MinSafeZoneRadius>
			<DefaultSafeZoneRadius>10</DefaultSafeZoneRadius>
			<SafeZoneActivationTimeS>120</SafeZoneActivationTimeS>
			<MaxSafeZonePowerDrainkW>128000</MaxSafeZonePowerDrainkW>
			<MinSafeZonePowerDrainkW>5000</MinSafeZonePowerDrainkW>
			<SafeZoneUpkeep>1</SafeZoneUpkeep>
			<SafeZoneUpkeepTimeM>60</SafeZoneUpkeepTimeM>
            <FillRatio>0.5</FillRatio>
            <ItemPullPerRequest>1</ItemPullPerRequest>

			<ActionSound>BlockSafeZone</ActionSound>
			<DestroyEffect>BlockDestroyedExplosion_Large</DestroyEffect>
			<DestroySound>WepSmallWarheadExpl</DestroySound>
			<PCU>50</PCU>
			<DLC>Economy2</DLC>
			<Repairable>false</Repairable>
		</Definition>

